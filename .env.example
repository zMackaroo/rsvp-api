PORT=3001

# Comma-separated origins allowed to call this API.
# Include localhost for local testing, and the Vercel URL when the site is live.
FRONTEND_ORIGIN=http://localhost:5173,http://192.168.254.109:5173

# Folder that should receive guest photos.
# Share this folder with the service account email as Editor.
GOOGLE_DRIVE_FOLDER_ID=

# Path to the Google service account JSON key
# (relative to /api or the repo root)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Optional instead of a key file: paste the JSON as one line
# GOOGLE_SERVICE_ACCOUNT_JSON=
