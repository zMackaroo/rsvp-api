PORT=3001

# Extra allowed origins, comma-separated. The Vercel site and localhost
# are already allowed in code.
FRONTEND_ORIGIN=

# Folder that should receive guest photos.
GOOGLE_DRIVE_FOLDER_ID=

# Required for a personal Gmail Drive (service accounts have no storage quota).
# Create an OAuth client (Desktop app), then run: npm run auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Only works with a Shared Drive, not a normal personal Drive folder.
# GOOGLE_SERVICE_ACCOUNT_JSON=
