{
  "name": "capture-api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --packages=external --format=esm --outfile=dist/index.js",
    "start": "node dist/index.js",
    "auth": "tsx scripts/google-auth.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "esbuild": "^0.25.12",
    "express": "^4.22.2",
    "googleapis": "^174.0.1",
    "multer": "^2.2.0",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "typescript": "~6.0.2"
  }
}
